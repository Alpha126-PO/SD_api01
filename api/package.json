{
  "name": "bkk-tourism-api",
  "version": "1.0.0",
  "description": "NestJS API สำหรับระบบแนะนำสถานที่ท่องเที่ยวตามเขต กทม. (อ่านข้อมูลจาก MySQL ที่โหลดไว้แล้ว)",
  "scripts": {
    "start": "ts-node src/main.ts",
    "start:dev": "nodemon --watch src --ext ts --exec ts-node src/main.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "mysql2": "^3.11.0"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "ts-node": "^10.9.2",
    "@types/node": "^22.5.4",
    "nodemon": "^3.1.4"
  }
}
